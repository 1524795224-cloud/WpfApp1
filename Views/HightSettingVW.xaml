<UserControl x:Class="WpfApp1.Views.HightSettingVW"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel>
            <TextBlock Text="{Binding PIN1X}" ></TextBlock>
            <TextBlock Text="{Binding PIN2X}" ></TextBlock>
            <TextBlock Text="{Binding PIN3X}" ></TextBlock>
            <TextBlock Text="{Binding PIN1Y}" ></TextBlock>
            <TextBlock Text="{Binding PIN2Y}" ></TextBlock>
            <TextBlock Text="{Binding PIN3Y}" ></TextBlock>
        </StackPanel>
      
    </Grid>
</UserControl>
