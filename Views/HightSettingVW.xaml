<UserControl x:Class="WpfApp1.Views.HightSettingVW"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <TextBlock Text="{Binding PIN1X}" Height="20" ></TextBlock>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <TextBlock Text="{Binding PIN2X}" Height="20"></TextBlock>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <TextBlock Text="{Binding PIN3X}" Height="20" ></TextBlock>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <TextBlock Text="{Binding PIN1Y}" Height="20"></TextBlock>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <TextBlock Text="{Binding PIN2Y}" Height="20"></TextBlock>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <TextBlock Text="{Binding PIN3Y}" Height="20" ></TextBlock>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                <Button Content="启动连接" Command="{Binding StartTcp}"/>
            </Border>





        </StackPanel>

    </Grid>
</UserControl>
